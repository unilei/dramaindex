# Raw HTTP cache: regenerable, large, no need to version
data/raw/

# Full catalogue snapshots (~3.7 MB/day). Regenerable by re-crawling, so they
# must NOT be versioned: committing them would add ~1.3 GB/year to the repo.
# The trend series in data/history/ is what gets committed instead - it is the
# only part of a crawl that cannot be re-derived.
data/snapshots/

# Runtime logs from the scheduled job
data/cron.log
data/cron.err.log

# Generated site output: rebuilt from data/snapshots + pipeline, and pushed
# separately to the gh-pages branch by deploy.sh
site/

__pycache__/
*.pyc
.DS_Store
